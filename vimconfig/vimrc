" Source plugin configs {{{
  fun! SourcePlugConfigs()
    let configs = glob(g:myvimdir.'/plugin_configs/*',0,1)
    for config in configs
      let type = config[-3:]
      " skip lua configs for vim
      if !s:is_nvim && type == 'lua' | continue | endif

    let plugin_name = fnamemodify(config,':t')[:-5]
    let plugin_dir = g:myvimdir.'/plugged/'.plugin_name
    let src = (type == 'vim') ? 'source ' : 'luafile '

    " run config if plugin is currently installed
    if isdirectory(plugin_dir) | exec src . config | endif
  endfor
endfun
" }}}
call SourcePlugConfigs()

