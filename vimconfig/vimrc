fun! s:ScrollMakesJump(type)
  let distance_til_jump = 150
  if line('.') != s:prev_scroll_line ||
        \ abs(line('.') - line("''")) >= distance_til_jump
    norm m'
  endif
  exec 'exec "normal! \<C-'.a:type.'>"'
  let s:prev_scroll_line = line('.')
endfun
