" simple swap between C header and source files {{{
fun! SwitchHeaderSource()
  let base = expand('%:t:r')
  let ext  = expand('%:e')
  let pairs = {
    \ 'c':   ['h'],
    \ 'cpp': ['hpp', 'h'],
    \ 'h':   ['c', 'cpp',],
    \ }
  if !has_key(pairs, ext) | return | endif

  " check current file's directory, its parent, and then the cwd
  let search_dirs = [
    \ expand('%:p:h'),
    \ expand('%:p:h:h'),
    \ getcwd(),
    \ ]

  for dir in search_dirs
    for candidate_ext in pairs[ext]
      let path = dir . '/' . base . '.' . candidate_ext
      if filereadable(path)
        execute 'edit ' . fnameescape(path)
        return
      endif
    endfor
  endfor

  echohl WarningMsg | echom "Couldn't find alternate file" | echohl None
endfun
" }}}
augroup vimrc_c_headerswap
  au!
  au FileType c,cpp nnoremap <buffer><silent> <Space>a :call SwitchHeaderSource()<CR>
augroup END

