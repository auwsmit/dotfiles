" <CR> in vimrc to edit or create plugin config {{{
" press Enter on [Plug 'author/plugin'] to create or open a local config file
fun! s:GotoPlugConfig()
  if getline('.') =~ "Plug '.*'"
    " this pattern matches the plugin name for a Plug line
    " e.g. Plug 'foo/bar.nvim' becomes the string 'bar.nvim'
    let pattern = "Plug.*'.*[\\/]\\zs[^\\/']\\+\\ze[\\/]*'"
    let plugin_name = matchstr(getline('.'), pattern)
    let path_to_config = resolve(g:myvimdir).'/plugin_configs/'.plugin_name
    if filereadable(path_to_config.'.vim')
      echo 'Found config for ' . plugin_name
      exec 'edit ' . fnameescape(path_to_config.'.vim')
    elseif filereadable(path_to_config.'.lua')
      echo 'Found config for ' . plugin_name
      exec 'edit ' . fnameescape(path_to_config.'.lua')
    else
      let msg = 'No plugin config found. Would you like to create one?'
      let choice1 = confirm(msg,"&No\n&yes",1)
      if choice1 == 2
        let choice2 = confirm('',"&Vim\nor &lua",1)
        let ftype = choice2 == 1 ? '.vim' : '.lua'
        redraw
        echo 'Editing local config for ' . plugin_name
        exec 'edit ' . fnameescape(path_to_config.ftype)
      endif
    endif
  endif
endfun

